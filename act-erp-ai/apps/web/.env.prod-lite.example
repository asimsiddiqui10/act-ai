# ─────────────────────────────────────────────────────────────────────
# ACT ERP — production env for the single-box "lite" deploy (no AI/chat).
# Copy to apps/web/.env.prod on the box, fill in the blanks. Do not commit.
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Postgres — same host/user/password as infra/postgres.env ──────────
DATABASE_URL=postgresql://act:REPLACE_WITH_SAME_PASSWORD@postgres:5432/act
DIRECT_URL=postgresql://act:REPLACE_WITH_SAME_PASSWORD@postgres:5432/act

# ── Auth (NextAuth v5). Generate: openssl rand -base64 32 ──────────────
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Temporary password-only login. Set true to restore emailed sign-in codes.
LOGIN_2FA_ENABLED=false

# ── S3 (or a Lightsail bucket / MinIO — anything S3-compatible) ────────
# Real IAM user (or instance-profile) creds scoped to just this bucket.
AWS_REGION=us-east-2
S3_BUCKET=your-bucket-name

# ── Login 2FA (Microsoft Graph) ─────────────────────────────────────
# Register an Entra application with Mail.Send application permission and
# restrict it to the dedicated sender mailbox. See docs/MICROSOFT-GRAPH-EMAIL.md.
EMAIL_PROVIDER=microsoft-graph
MICROSOFT_TENANT_ID=replace-with-entra-tenant-id
MICROSOFT_CLIENT_ID=replace-with-app-client-id
MICROSOFT_CLIENT_SECRET=replace-with-app-client-secret
MICROSOFT_SENDER_USER=noreply@americancompletiontools.com
# SES fallback (only used when EMAIL_PROVIDER=ses):
# SES_FROM_EMAIL=noreply@americancompletiontools.com
AWS_ACCESS_KEY_ID=replace-with-a-scoped-iam-user-key
AWS_SECRET_ACCESS_KEY=replace-with-a-scoped-iam-user-secret
# Only set AWS_ENDPOINT_URL if using a non-AWS S3-compatible store (e.g. a
# Lightsail bucket's custom endpoint). Leave unset for real AWS S3.
# AWS_ENDPOINT_URL=

# ── AI document-chat feature — off for this deploy ────────────────────
# With AI_ENABLED=false the Assistant/Knowledge nav is hidden, those pages
# render "Page not found", and /api/chat returns 503. SQS_QUEUE_URL,
# AGENT_SERVICE_URL and INTERNAL_SERVICE_TOKEN are optional while it's off
# — leave them unset. (Setting AI_ENABLED=true without them fails at boot
# with a clear message rather than 500ing later.)
AI_ENABLED=false

# Exact facility public IPs or IPv4 CIDRs. Enforced on kiosk *activation*
# only — punches use the device cookie. Starlink sites often need multiple
# IPs because egress rotates (e.g. 74.x and 98.x for the same shop).
KIOSK_ALLOWED_NETWORKS=74.244.47.248/32,98.97.87.35/32

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://persona.americancompletiontools.com

SKIP_ENV_VALIDATION=false

# ── Hire packet import (optional LLM gap-fill) ───────────────────────
# ANTHROPIC_API_KEY=
